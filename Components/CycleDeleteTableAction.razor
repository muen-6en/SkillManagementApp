@inject IDbContextFactory<AppDbContext> DbFactory

<div class="cycle-delete-table-action">
    @if (_confirming)
    {
        <p class="validation-message" role="alert">@ConfirmMessage</p>
        @if (_deleteError is not null)
        {
            <p class="validation-message" role="alert">@_deleteError</p>
        }
        <div class="form-actions">
            <button type="button" class="btn-danger btn-compact" @onclick="ConfirmDeleteAsync">削除する</button>
            <button type="button" class="btn-secondary btn-compact" @onclick="CancelConfirm">キャンセル</button>
        </div>
    }
    else
    {
        <button type="button"
                class="btn-danger btn-compact"
                aria-label="@($"{Sequence} のサイクルを削除")"
                @onclick="StartConfirm">
            削除
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public int SkillId { get; set; }

    [Parameter, EditorRequired]
    public int CycleId { get; set; }

    [Parameter, EditorRequired]
    public int Sequence { get; set; }

    [Parameter]
    public string ConfirmMessage { get; set; } = "このサイクルを削除しますか？やることと記録も一緒に消えます。";

    [Parameter]
    public EventCallback OnDeleted { get; set; }

    private bool _confirming;
    private string? _deleteError;

    private void StartConfirm()
    {
        _confirming = true;
        _deleteError = null;
    }

    private void CancelConfirm()
    {
        _confirming = false;
        _deleteError = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        _deleteError = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var deleted = await DeletionOperations.TryDeleteCycleAsync(db, SkillId, CycleId);
            if (!deleted)
            {
                _deleteError = "削除できませんでした。";
                return;
            }

            await OnDeleted.InvokeAsync();
        }
        catch (Exception)
        {
            _deleteError = "削除に失敗しました。データは残っています。";
        }
    }
}
