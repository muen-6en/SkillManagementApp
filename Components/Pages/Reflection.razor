@page "/skills/{SkillId:int}/cycles/{CycleId:int}/reflection"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>@AppRoutes.PageTitle("ふりかえり")</PageTitle>

@if (_invalid)
{
    <CycleStageNav StageTitle="ふりかえり" />
    <h1>ふりかえり</h1>
    <p role="alert">指定されたスキルまたはサイクルは見つかりませんでした。</p>
}
else if (_skill is not null && _cycle is not null)
{
    <CycleStageNav StageTitle="ふりかえり" />

    <CycleSequenceLabel Sequence="@_cycle.Sequence" SkillId="@SkillId" CycleId="@CycleId" />
    <h1>ふりかえり</h1>
    <CycleDiffButton DiffHref="@CycleRoutes.Diff(SkillId, CycleId)" />
    <CycleContextSummary Skill="@_skill" Cycle="@_cycle" />
    <p>このサイクルで予定したことと、実際にやったことを確認してから、メモを残します。</p>

    <section class="panel" aria-labelledby="reflection-plan-heading">
        <h2 id="reflection-plan-heading">やること</h2>
        @if (string.IsNullOrWhiteSpace(_actionBody))
        {
            <p class="status status-info" role="status">やることは未設定です。</p>
        }
        else
        {
            <p class="record-body">@_actionBody</p>
        }
    </section>

    <section class="panel" aria-labelledby="reflection-done-heading">
        <h2 id="reflection-done-heading">やったこと</h2>
        @if (_records.Count == 0)
        {
            <p class="status status-info" role="status">実践記録はまだありません。</p>
        }
        else
        {
            <ul class="record-list">
                @foreach (var record in _records)
                {
                    <li>
                        <time datetime="@record.RecordedAt.ToString("yyyy-MM-ddTHH:mm:ss")">
                            @record.RecordedAt.ToString("yyyy-MM-dd HH:mm")
                        </time>
                        <p class="record-body">@record.Body</p>
                    </li>
                }
            </ul>
        }
    </section>

    @if (_nextCycleId is int nextCycleId)
    {
        <p class="status status-success" role="status">次のサイクルは作成済みです。</p>
        <p>
            <a class="btn-primary cycle-next-button"
               href="@CycleRoutes.Current(SkillId, nextCycleId)">
                新しいサイクルの現状へ進む
            </a>
        </p>
    }

    @if (_isReflectionSaved)
    {
        <p class="status status-success" role="status">サイクルのメモは保存済みです。</p>
    }
    else
    {
        <p class="status status-info" role="status">サイクルのメモはまだ保存されていません。</p>
    }

    <EditForm Model="_form" FormName="saveReflection" OnSubmit="SaveAsync">
        <div class="form-field">
            <label for="reflection-body">サイクルのメモ</label>
            <InputTextArea id="reflection-body"
                           class="form-control form-control-multiline"
                           @bind-Value="_form.Body"
                           aria-describedby="reflection-body-error reflection-save-status"
                           aria-invalid="@(_bodyError is not null)"
                           rows="6"
                           maxlength="4000"
                           disabled="@(_nextCycleId is not null)" />
            @if (_bodyError is not null)
            {
                <p id="reflection-body-error" class="validation-message" role="alert">@_bodyError</p>
            }
        </div>
        @if (_saveError is not null)
        {
            <p class="validation-message" role="alert">@_saveError</p>
        }
        @if (_saveStatus is not null)
        {
            <p id="reflection-save-status" class="status status-success" role="status">@_saveStatus</p>
        }
        <div class="form-actions cycle-form-submit">
            <a class="btn-back cycle-next-button"
               href="@CycleRoutes.Practice(SkillId, CycleId)">
                実践記録に戻る
            </a>
            @if (_nextCycleId is null)
            {
                <button type="submit" class="btn-save">メモを保存</button>
                <button type="button" class="btn-primary" @onclick="CreateNextCycleAsync">次のサイクルを作る</button>
            }
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int SkillId { get; set; }

    [Parameter]
    public int CycleId { get; set; }

    private Skill? _skill;
    private Cycle? _cycle;
    private string? _actionBody;
    private IReadOnlyList<PracticeRecord> _records = Array.Empty<PracticeRecord>();
    private int? _nextCycleId;
    private bool _invalid;
    private bool _isReflectionSaved;
    private readonly ReflectionForm _form = new();
    private string? _bodyError;
    private string? _saveError;
    private string? _saveStatus;

    protected override async Task OnParametersSetAsync()
    {
        _invalid = false;
        _skill = null;
        _cycle = null;
        _actionBody = null;
        _records = Array.Empty<PracticeRecord>();
        _nextCycleId = null;
        _bodyError = null;
        _saveError = null;
        _saveStatus = null;

        await using var db = await DbFactory.CreateDbContextAsync();
        var context = await CycleOperations.TryGetCycleContextAsync(db, SkillId, CycleId);
        if (context is null)
        {
            _invalid = true;
            return;
        }

        (_skill, _cycle) = context.Value;

        var action = await db.CycleActions
            .AsNoTracking()
            .FirstOrDefaultAsync(item => item.CycleId == CycleId);
        _actionBody = action?.Body;
        _records = await db.PracticeRecords
            .AsNoTracking()
            .Where(record => record.CycleId == CycleId)
            .OrderByDescending(record => record.RecordedAt)
            .ThenByDescending(record => record.Id)
            .ToListAsync();

        var reflection = await db.ReflectionEntries
            .AsNoTracking()
            .FirstOrDefaultAsync(item => item.CycleId == CycleId);

        _form.Body = reflection?.Body ?? string.Empty;
        _nextCycleId = reflection?.NextCycleId;
        _isReflectionSaved = reflection is not null && !string.IsNullOrWhiteSpace(reflection.Body);
    }

    private async Task SaveAsync()
    {
        _bodyError = null;
        _saveError = null;
        _saveStatus = null;

        if (_nextCycleId is not null)
        {
            return;
        }

        var body = _form.Body.Trim();
        if (string.IsNullOrEmpty(body))
        {
            _bodyError = "サイクルのメモを入力してください。";
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var reflection = await db.ReflectionEntries.FirstOrDefaultAsync(item => item.CycleId == CycleId);
            if (reflection is null)
            {
                db.ReflectionEntries.Add(new ReflectionEntry
                {
                    CycleId = CycleId,
                    Body = body,
                });
            }
            else if (reflection.NextCycleId is null)
            {
                reflection.Body = body;
            }

            await db.SaveChangesAsync();
            _isReflectionSaved = true;
            _saveStatus = "サイクルのメモを保存しました。";
        }
        catch (Exception)
        {
            _saveError = "保存に失敗しました。入力内容はそのまま残っています。";
        }
    }

    private async Task CreateNextCycleAsync()
    {
        _bodyError = null;
        _saveError = null;
        _saveStatus = null;

        if (_nextCycleId is not null)
        {
            return;
        }

        var body = _form.Body.Trim();
        if (string.IsNullOrEmpty(body))
        {
            _bodyError = "サイクルのメモを入力してから、次のサイクルを作ってください。";
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var nextCycle = await CycleOperations.CreateNextCycleAsync(db, SkillId, CycleId, body);
            if (nextCycle is null)
            {
                _saveError = "次のサイクルを作れませんでした。入力内容はそのまま残っています。";
                return;
            }

            Navigation.NavigateTo(CycleRoutes.Current(SkillId, nextCycle.Id));
        }
        catch (Exception)
        {
            _saveError = "次のサイクルを作れませんでした。入力内容はそのまま残っています。";
        }
    }

    private sealed class ReflectionForm
    {
        public string Body { get; set; } = string.Empty;
    }
}

