    private sealed record GrowthPoint(double X, double? CurrentY, double? TargetY, int Sequence, string Period);

    private sealed record RadarAxis(
        string Name,
        string CycleLabel,
        double EndX,
        double EndY,
        double LabelX,
        double LabelY,
        double ValueX,
        double ValueY,
        bool HasValue);
}
