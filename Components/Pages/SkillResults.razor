@page "/skills/{SkillId:int}/results"
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>@AppRoutes.PageTitle("実績")</PageTitle>

@if (_invalid)
{
    <CycleStageNav StageTitle="実績" />
    <h1>実績</h1>
    <p role="alert">指定されたスキルは見つかりませんでした。</p>
}
else if (_skill is not null)
{
    <CycleStageNav StageTitle="実績" />
    <h1>実績</h1>
    @if (_displayedCycle is not null)
    {
        <CycleContextSummary Skill="@_skill" Cycle="@_displayedCycle" />
    }
    <p>表でサイクルを選び、実践記録の件数を確認します。現在のレベル、目標のレベル、期間、やることは上の設定で確認します。</p>

    @if (_rows.Count == 0)
    {
        <p class="status status-info" role="status">サイクルはまだありません。</p>
    }
    else
    {
        <div class="diff-table-wrap">
            <table class="diff-table results-table">
                <caption class="visually-hidden">@_skill.Name のサイクル別実績</caption>
                <thead>
                    <tr>
                        <th scope="col">選択</th>
                        <th scope="col">サイクルの順</th>
                        <th scope="col">実践記録の件数</th>
                        <th scope="col">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>
                                <input type="radio"
                                       name="results-cycle"
                                       value="@row.CycleId"
                                       checked="@(row.CycleId == _selectedCycleId)"
                                       @onchange="() => _selectedCycleId = row.CycleId"
                                       aria-label="@($"{row.Sequence} のサイクルを選択")" />
                            </td>
                            <th scope="row">@row.Sequence</th>
                            <td>@row.RecordCount</td>
                            <td>
                                <CycleDeleteTableAction SkillId="@SkillId"
                                                        CycleId="@row.CycleId"
                                                        Sequence="@row.Sequence"
                                                        OnDeleted="@ReloadRowsAsync" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="form-actions">
            <button type="button"
                    class="btn-primary"
                    @onclick="ShowSelectedCycleAsync"
                    disabled="@(_selectedCycleId == 0)">
                選択したサイクルの状態を表示
            </button>
            @if (_selectedCycleId != 0)
            {
                <a class="btn-primary cycle-next-button"
                   href="@CycleRoutes.Diff(SkillId, _selectedCycleId)">
                    差分を見る
                </a>
            }
        </div>
    }
}

@code {
    [Parameter]
    public int SkillId { get; set; }

    private Skill? _skill;
    private Cycle? _displayedCycle;
    private IReadOnlyList<SkillResultRow> _rows = Array.Empty<SkillResultRow>();
    private bool _invalid;
    private int _selectedCycleId;

    protected override async Task OnParametersSetAsync()
    {
        _invalid = false;
        _skill = null;
        _displayedCycle = null;
        _rows = Array.Empty<SkillResultRow>();
        _selectedCycleId = 0;

        await using var db = await DbFactory.CreateDbContextAsync();
        var skill = await db.Skills.AsNoTracking().FirstOrDefaultAsync(item => item.Id == SkillId);
        if (skill is null)
        {
            _invalid = true;
            return;
        }

        _skill = skill;
        var latestCycle = await db.Cycles
            .AsNoTracking()
            .Where(item => item.SkillId == SkillId)
            .OrderByDescending(item => item.Sequence)
            .ThenByDescending(item => item.Id)
            .FirstOrDefaultAsync();
        _rows = await SkillResultsLoader.LoadAsync(db, SkillId);
        _selectedCycleId = latestCycle?.Id ?? 0;
        _displayedCycle = latestCycle;
    }

    private async Task ReloadRowsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _rows = await SkillResultsLoader.LoadAsync(db, SkillId);
        var selectedCycle = await db.Cycles
            .AsNoTracking()
            .FirstOrDefaultAsync(item => item.Id == _selectedCycleId && item.SkillId == SkillId);
        if (selectedCycle is null)
        {
            selectedCycle = await db.Cycles
                .AsNoTracking()
                .Where(item => item.SkillId == SkillId)
                .OrderByDescending(item => item.Sequence)
                .ThenByDescending(item => item.Id)
                .FirstOrDefaultAsync();
            _selectedCycleId = selectedCycle?.Id ?? 0;
        }

        _displayedCycle = selectedCycle;
    }

    private async Task ShowSelectedCycleAsync()
    {
        if (_selectedCycleId == 0)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        _displayedCycle = await db.Cycles
            .AsNoTracking()
            .FirstOrDefaultAsync(item => item.Id == _selectedCycleId && item.SkillId == SkillId);
    }
}
