@inject IDbContextFactory<AppDbContext> DbFactory

<section class="panel panel-danger skill-delete-panel" aria-labelledby="@HeadingId">
    <h3 id="@HeadingId">スキルの削除</h3>
    <p>スキル「@SkillName」と、そのサイクル以下のデータを削除します。</p>

    @if (_confirming)
    {
        <p class="validation-message" role="alert">本当に削除しますか？この操作は取り消せません。</p>
        @if (_deleteError is not null)
        {
            <p class="validation-message" role="alert">@_deleteError</p>
        }
        <div class="form-actions">
            <button type="button" class="btn-danger" @onclick="ConfirmDeleteAsync">削除する</button>
            <button type="button" class="btn-secondary" @onclick="CancelConfirm">キャンセル</button>
        </div>
    }
    else
    {
        <button type="button" class="btn-danger" @onclick="StartConfirm">このスキルを削除</button>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public int SkillId { get; set; }

    [Parameter, EditorRequired]
    public string SkillName { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnDeleted { get; set; }

    [Parameter]
    public string HeadingId { get; set; } = "delete-skill-heading";

    private bool _confirming;
    private string? _deleteError;

    private void StartConfirm()
    {
        _confirming = true;
        _deleteError = null;
    }

    private void CancelConfirm()
    {
        _confirming = false;
        _deleteError = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        _deleteError = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var deleted = await DeletionOperations.TryDeleteSkillAsync(db, SkillId);
            if (!deleted)
            {
                _deleteError = "削除できませんでした。";
                return;
            }

            _confirming = false;
            await OnDeleted.InvokeAsync();
        }
        catch (Exception)
        {
            _deleteError = "削除に失敗しました。データは残っています。";
        }
    }
}
